#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance watch
	procd_set_param command /usr/sbin/cellmgr-watch
	procd_set_param respawn 3600 5 0
	procd_close_instance

	procd_open_instance cloud
	procd_set_param command /usr/sbin/cellmgr-cloud
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
